{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/context_warning.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/context_warning.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/context_warning.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/context_warning.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
